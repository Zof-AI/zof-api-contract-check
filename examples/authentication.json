{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic catalog",
    "version": "1.0"
  },
  "paths": {
    "/items": {
      "get": {
        "responses": {
          "200": {
            "description": "Catalog item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
